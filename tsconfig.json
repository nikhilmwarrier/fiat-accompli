{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",                
    "moduleResolution": "NodeNext",      
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "moduleDetection": "force",          
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
